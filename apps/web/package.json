{
  "name": "sorxill-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "size-limit": "^11.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "все клиентские чанки (brotli)",
      "path": ".next/static/chunks/**/*.js",
      "limit": "260 kB"
    }
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
