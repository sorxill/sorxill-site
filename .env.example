# СПРАВОЧНИК переменных, а не файл для заполнения.
#
# Прод: .env на сервере собирает пайплайн из GitHub Environment production.
#       Руками не редактируется — см. docs/adr/0016-upravlenie-sekretami.md
# Локально: cp .env.example .env и заполнить только то, что нужно для make dev
#           (пароли можно любые: локальная база одноразовая).
#
# ЛОКАЛЬНАЯ разработка. На проде этот файл не используется:
# там .env.secrets генерирует пайплайн из GitHub Environment "production",
# а теги образов дописывает rollout.sh. Руками на сервере ничего не правим.
#
# Что где лежит в GitHub:
#   Secrets  — то, что нельзя увидеть: пароли, токены, ключи
#   Variables — то, что не секрет: домен, имена пользователей, endpoint'ы
#
# Secrets:   DEPLOY_KEY SERVER_A_HOST SERVER_B_HOST ACME_EMAIL POSTGRES_PASSWORD
#            SECRET_KEY IP_PEPPER REVALIDATE_SECRET SMTP_HOST SMTP_USER
#            SMTP_PASSWORD SMTP_FROM FEED_GITHUB_TOKEN UMAMI_SECRET SENTRY_DSN
#            GRAFANA_CLOUD_TOKEN TG_TOKEN TG_CHAT
# Variables: DOMAIN CONTACT_PERSIST S3_ENDPOINT S3_BUCKET AGE_RECIPIENT
#            GRAFANA_LOKI_URL GRAFANA_LOKI_USER GRAFANA_PROM_URL GRAFANA_PROM_USER

APP_ENV=local
DOMAIN=localhost
LOG_LEVEL=DEBUG

POSTGRES_DB=sorxill
POSTGRES_USER=sorxill
POSTGRES_PASSWORD=local

SECRET_KEY=dev-only-not-a-secret
IP_PEPPER=dev-only-not-a-secret
REVALIDATE_SECRET=dev-only-not-a-secret
CONTACT_PERSIST=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GITHUB_TOKEN=
GITHUB_USERNAME=sorxill
NEXT_PUBLIC_CALCOM_LINK=
